  },
  "peerDependenciesMeta": {
    "elm-format": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "cross-env": "^7.0.3",
    "elm": "^0.19.1-5",
    "elm-test-rs": "^3.0.0-5",
    "node-elm-compiler": "^5.0.6",
    "typescript": "^5.8.3",
    "uglify-js": "^3.19.3"
  }
