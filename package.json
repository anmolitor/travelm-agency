{
  "name": "travelm-agency",
  "version": "3.8.0",
  "description": "Generate type-safe accessors and decoders for your i18n files",
  "main": "./lib/main.js",
  "bin": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && cross-env NODE_ENV=production node build.js",
    "build:dev": "node build.js",
    "test": "node generate_test_cases.js && elm-test-rs"
  },
  "keywords": [
    "Elm",
    "I18n",
    "JSON",
    "Codegen"
  ],
